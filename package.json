{
  "name": "safetrail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:local": "tsx scripts/dev-db.ts",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "admin:create-user": "tsx --env-file=.env.local scripts/create-user.ts",
    "ext:build": "node extension/build.mjs",
    "ext:watch": "node extension/build.mjs --watch",
    "fixtures:serve": "tsx scripts/serve-fixtures.ts",
    "test": "vitest run",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/chrome": "^0.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.21.0"
}
