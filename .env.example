# Postgres. Local development: run `pnpm db:local` and use
# postgres://postgres:postgres@localhost:54329/safetrail for both.
DATABASE_URL=            # Supabase pooled (transaction, port 6543) or direct
DIRECT_URL=              # direct connection (5432), used by drizzle-kit
BETTER_AUTH_SECRET=      # 32+ random bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase Storage. Leave SUPABASE_URL empty in development to store
# evidence files on local disk under .data/storage instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server only. Never import in client code
SUPABASE_STORAGE_BUCKET=evidence
ALLOWED_EMAIL_DOMAIN=ms.bulsu.edu.ph
DEV_ALLOWED_EMAILS=      # optional comma list that bypasses the domain check (demo accounts)
EXTENSION_ORIGIN=chrome-extension://idlfmehfilgnnlgpiokgpanpjdfnejnd   # printed by `pnpm ext:build`; added to Better Auth trustedOrigins
