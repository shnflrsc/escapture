{
  "manifest_version": 3,
  "name": "Escapture Escrow Capture",
  "version": "0.0.0",
  "description": "Save a tamper-checked copy of a Facebook post or conversation to your Escapture vault.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Escapture Escrow Capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://www.messenger.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*"],
      "js": ["page-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*"],
      "js": ["guard-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
